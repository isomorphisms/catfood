"""Selected profile facts and mutable unknowns must retain their scope."""
from argparse import ArgumentParser
from pathlib import Path
from builtins import dict, ValueError
import subprocess
import json

def main() → None:
    parser ∈ ArgumentParser ← ArgumentParser()
    for name in ["ithon", "python", "output"]:
        parser.add_argument("--" + name, required=True)
    args ∈ object ← parser.parse_args()
    ithon ∈ str ← args.ithon
    python ∈ str ← args.python
    output ∈ str ← args.output
    root ∈ Path ← Path(output).resolve()
    root.mkdir(mode=448, exist_ok=False)
    source ∈ str ← __file__
    program ∈ Path ← Path(source).resolve().parent.joinpath("profile.pi")
    environment ∈ dict[str, str] ← dict()
    environment.__setitem__("PATH", "/usr/bin:/bin")
    environment.__setitem__("ITHON_PYTHON", python)
    ledger ← "case\texpected\tobserved_exit\tresult\n"
    for name in ["stable", "inventory", "absent", "conflict", "firmware", "current-missing"]:
        case ∈ Path ← root.joinpath(name)
        case.mkdir()
        argv ∈ list[str] ← [ithon, str(program), "--model", "miro-a1", "--instance", "selected-one", "--output", str(case.joinpath("profile.json"))]
        expected ← "PASS"
        if name == "absent":
            argv.__setitem__(3, "unknown-model")
            expected ← "PROFILE_ABSENT"
        if name == "current-missing":
            argv.append("--require-current")
            expected ← "PROFILE_FRESHNESS"
        if name in ["inventory", "conflict", "firmware"]:
            instance ← "selected-one"
            if name == "conflict":
                instance ← "different-one"
                expected ← "PROFILE_CONFLICT:physical instance"
            case.joinpath("inventory.tsv").write_text("meta\tdevice_id\t" + instance + "\tfixture\nmeta\tmodel\tMIRO A1\tfixture\nmeta\tbuild_fingerprint\tfirmware-a\tfixture\n")
            argv.extend(["--inventory", str(case.joinpath("inventory.tsv"))])
            if name == "firmware":
                argv.extend(["--firmware", "firmware-b"])
                expected ← "PROFILE_FRESHNESS"
        child ∈ subprocess.CompletedProcess ← subprocess.run(argv, env=environment, capture_output=True, timeout=10)
        code ∈ int ← child.returncode
        error ∈ bytes ← child.stderr
        case.joinpath("stderr").write_bytes(error)
        if expected == "PASS":
            if code != 0:
                raise ValueError("VALID_PROFILE_FAILED")
            record ∈ dict[str, object] ← json.loads(case.joinpath("profile.json").read_text())
            context ∈ str ← record.get("application_context")
            capability ∈ str ← record.get("current_session_capabilities")
            installed ∈ str ← record.get("installed_application_identity")
            if context != "UNKNOWN" or capability != "UNKNOWN" or installed != "UNKNOWN":
                raise ValueError("HISTORICAL_FACT_PROMOTED")
            availability ∈ str ← record.get("availability")
            if availability == "":
                raise ValueError("MISSING_PROVENANCE_AVAILABILITY")
        else:
            matched ∈ bool ← error.__contains__(expected.encode())
            if code == 0 or matched == False:
                raise ValueError("PROFILE_REJECTION_MISSING:" + name)
        ledger ← ledger + name + "\t" + expected + "\t" + str(code) + "\tPASS\n"
    root.joinpath("results.tsv").write_text(ledger)
    print(ledger)

main()
