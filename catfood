#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

usage() {
    cat <<'EOF'
usage: ./catfood [--target]
       ./catfood help [tool]
       ./catfood where [tool]
       ./catfood register TOOL ROLE PATH

Feed the selected Cat Food target.

The target is detected automatically when possible:
  phone      Termux on ARMv7; install verified runtime packages only
  tablet     Termux on AArch64; install verified runtime packages only
  container  disposable Debian/Ubuntu workbench; select explicitly
  cloud      persistent Debian/Ubuntu/Hetzner workbench

Compatibility targets:
  termux     generic Termux source workbench when architecture is unknown/forced
  hetzner    alias for cloud
  CATFOOD_TARGET=cloud|termux remains valid

Help:
  ./catfood help          list every Cat Food tool
  ./catfood help TOOL     show that tool's Cat Food reference

Local checkout lookup:
  ./catfood where         list verified local checkouts as: TOOL<TAB>ROLE<TAB>PATH
  ./catfood where TOOL    list all verified local checkouts for TOOL
  ./catfood register TOOL ROLE PATH
                          register a verified noncanonical or additional checkout
  roles: workbench, acceptance, test, cache, control, other

Overrides:
  CATFOOD_TARGET=phone|tablet|container|cloud|termux|hetzner
  CATFOOD_ROOT=/path/to/workspace
  CATFOOD_BUILD_TOOLS=0|1
  CATFOOD_INSTALL_YSH=0|1
  CATFOOD_CHECKOUTS=/path/to/machine-local-checkouts.tsv
EOF
}

help_index() {
    printf '%s\n' 'Cat Food help topics:'
    printf '  %s\n' grease csvkit
    awk '$1 !~ /^#/ && NF >= 4 { print "  " $1 }' "$root/tools.tsv"
    cat <<'EOF'

Use: ./catfood help TOOL
A checked-in docs/help/TOOL.md page overrides the generic inventory reference.
EOF
}

show_inventory_help() {
    topic=$1

    if [ "$topic" = grease ]; then
        cat <<'EOF'
# grease

Repository: https://github.com/isomorphisms/grease.git
Branch: main
Canonical workbench checkout: $CATFOOD_ROOT/grease
Local presence: use ./catfood where grease; do not assume the checkout exists.
Cat Food role: stage-one shell bootstrap, fed separately before tools.tsv.

Cat Food keeps Grease outside tools.tsv because it supplies the shell used to feed the remaining workbench. See bootstrap.sh for the exact bootstrap path and the Grease checkout itself for repository-specific command help.
EOF
        return 0
    fi

    line=$(awk -v topic="$topic" '$1 !~ /^#/ && NF >= 4 && $1 == topic { print; found=1; exit } END { if (!found) exit 1 }' "$root/tools.tsv") || return 1
    set -- $line
    name=$1
    repository=$2
    branch=$3
    submodules=$4

    printf '# %s\n\n' "$name"
    printf 'Repository: %s\n' "$repository"
    printf 'Branch: %s\n' "$branch"
    printf 'Submodules: %s\n' "$submodules"
    printf 'Canonical workbench checkout: $CATFOOD_ROOT/%s\n' "$name"
    printf '%s\n' 'Local presence: use ./catfood where TOOL; do not assume the checkout exists.'
    printf '%s\n\n' 'Cat Food role: workbench inventory entry.'
    printf '%s\n' 'This generic page records where Cat Food gets the tool and how it is fed. For repository-specific commands, use the tool or checkout help/README. A docs/help/TOOL.md page can provide a richer Cat Food reference for APIs, protocols, environment variables, examples, or target-specific constraints.'
}

show_help_page() {
    topic=${1:-}
    if [ -z "$topic" ]; then
        help_index
        return 0
    fi

    page=$root/docs/help/$topic.md
    if [ -f "$page" ]; then
        cat "$page"
        return 0
    fi

    if show_inventory_help "$topic"; then
        return 0
    fi

    printf 'unknown Cat Food help topic: %s\n\n' "$topic" >&2
    help_index >&2
    return 2
}

detect_target() {
    case ${PREFIX:-}:${TERMUX_VERSION:-} in
        /data/data/com.termux/*:*|*:*?*)
            machine=$(uname -m 2>/dev/null || printf '%s\n' unknown)
            case $machine in
                armv7*|armv8l|arm) printf '%s\n' phone ;;
                aarch64|arm64) printf '%s\n' tablet ;;
                *) printf '%s\n' termux ;;
            esac
            ;;
        *) printf '%s\n' cloud ;;
    esac
}

normalize_repository_url() {
    repository=${1%.git}
    case $repository in
        git@github.com:*)
            repository=https://github.com/${repository#git@github.com:}
            ;;
        ssh://git@github.com/*)
            repository=https://github.com/${repository#ssh://git@github.com/}
            ;;
    esac
    printf '%s\n' "$repository"
}

repository_matches() {
    checkout=$1
    expected=$2

    [ -e "$checkout/.git" ] || return 1
    origin=$(git -C "$checkout" remote get-url origin 2>/dev/null || true)
    [ -n "$origin" ] || return 1

    [ "$(normalize_repository_url "$origin")" = "$(normalize_repository_url "$expected")" ]
}

lookup_workspace() {
    if [ -n "${CATFOOD_ROOT:-}" ]; then
        printf '%s\n' "$CATFOOD_ROOT"
        return 0
    fi

    lookup_target=${CATFOOD_TARGET:-auto}
    if [ "$lookup_target" = auto ]; then
        lookup_target=$(detect_target)
    fi
    case $lookup_target in
        hetzner) lookup_target=cloud ;;
    esac

    case $lookup_target in
        cloud)
            printf '%s\n' /opt
            ;;
        container)
            if [ -w /opt ]; then
                printf '%s\n' /opt
            else
                printf '%s\n' "$HOME/opt"
            fi
            ;;
        phone|tablet|termux)
            printf '%s\n' "$HOME/opt"
            ;;
        *)
            printf 'CATFOOD_TARGET must be phone, tablet, container, cloud, termux, or hetzner; found: %s\n' "$lookup_target" >&2
            return 2
            ;;
    esac
}

lookup_tool() {
    topic=$1
    manifest=${CATFOOD_MANIFEST:-$root/tools.tsv}

    case $topic in
        catfood)
            lookup_name=catfood
            lookup_repository=https://github.com/isomorphisms/catfood.git
            return 0
            ;;
        grease)
            lookup_name=grease
            lookup_repository=https://github.com/isomorphisms/grease.git
            return 0
            ;;
    esac

    line=$(awk -v topic="$topic" '$1 !~ /^#/ && NF >= 4 && $1 == topic { print; found=1; exit } END { if (!found) exit 1 }' "$manifest") || return 1
    set -- $line
    lookup_name=$1
    lookup_repository=$2
}

checkout_inventory() {
    if [ -n "${CATFOOD_CHECKOUTS:-}" ]; then
        printf '%s\n' "$CATFOOD_CHECKOUTS"
        return 0
    fi

    state_home=${XDG_STATE_HOME:-$HOME/.local/state}
    printf '%s\n' "$state_home/catfood/checkouts.tsv"
}

validate_checkout_inventory() {
    inventory=$(checkout_inventory)
    [ -e "$inventory" ] || return 0
    if [ ! -f "$inventory" ]; then
        printf 'Cat Food checkout inventory is not a regular file: %s\n' "$inventory" >&2
        return 2
    fi

    awk -F '\t' '
        /^[[:space:]]*($|#)/ { next }
        NF != 3 {
            printf "%s:%d: expected TOOL<TAB>ROLE<TAB>PATH\n", FILENAME, NR > "/dev/stderr"
            failed = 1
            next
        }
        $1 !~ /^[[:alnum:]_.-]+$/ {
            printf "%s:%d: unsafe tool name: %s\n", FILENAME, NR, $1 > "/dev/stderr"
            failed = 1
        }
        $2 != "workbench" && $2 != "acceptance" && $2 != "test" &&
        $2 != "cache" && $2 != "control" && $2 != "other" {
            printf "%s:%d: invalid checkout role: %s\n", FILENAME, NR, $2 > "/dev/stderr"
            failed = 1
        }
        $3 !~ /^\// {
            printf "%s:%d: checkout path must be absolute: %s\n", FILENAME, NR, $3 > "/dev/stderr"
            failed = 1
        }
        END { exit failed }
    ' "$inventory" || return $?

    tab=$(printf '\t')
    awk -F '\t' '/^[[:space:]]*($|#)/ { next } { print $1 "\t" $2 "\t" $3 }' "$inventory" |
    while IFS="$tab" read -r registered_tool registered_role registered_path; do
        if ! lookup_tool "$registered_tool"; then
            printf '%s: checkout inventory names unknown Cat Food tool\n' "$registered_tool" >&2
            exit 2
        fi
    done
}

registered_candidates() {
    topic=$1
    inventory=$(checkout_inventory)
    [ -f "$inventory" ] || return 0

    awk -F '\t' -v topic="$topic" '
        /^[[:space:]]*($|#)/ { next }
        topic == "" || $1 == topic { print $1 "\t" $2 "\t" $3 }
    ' "$inventory"
}

canonical_candidates() {
    topic=$1
    workspace=$(lookup_workspace) || return $?

    if [ -n "$topic" ]; then
        if ! lookup_tool "$topic"; then
            printf 'unknown Cat Food tool: %s\n' "$topic" >&2
            return 2
        fi
        if [ "$lookup_name" = catfood ]; then
            printf 'catfood\tcontrol\t%s\n' "$root"
        else
            printf '%s\tworkbench\t%s/%s\n' "$lookup_name" "$workspace" "$lookup_name"
        fi
        return 0
    fi

    printf 'catfood\tcontrol\t%s\n' "$root"
    printf 'grease\tworkbench\t%s/grease\n' "$workspace"
    awk '$1 !~ /^#/ && NF >= 4 { print $1 }' "${CATFOOD_MANIFEST:-$root/tools.tsv}" |
    while IFS= read -r candidate_tool; do
        printf '%s\tworkbench\t%s/%s\n' "$candidate_tool" "$workspace" "$candidate_tool"
    done
}

verify_candidates() {
    tab=$(printf '\t')
    while IFS="$tab" read -r candidate_tool candidate_role candidate_path; do
        [ -n "$candidate_tool" ] || continue
        if ! lookup_tool "$candidate_tool"; then
            printf '%s: checkout candidate names unknown Cat Food tool\n' "$candidate_tool" >&2
            return 2
        fi
        if repository_matches "$candidate_path" "$lookup_repository"; then
            printf '%s\t%s\t%s\n' "$candidate_tool" "$candidate_role" "$candidate_path"
        fi
    done
}

where_inventory() {
    topic=${1:-}

    validate_checkout_inventory || return $?
    if [ -n "$topic" ] && ! lookup_tool "$topic"; then
        printf 'unknown Cat Food tool: %s\n' "$topic" >&2
        return 2
    fi

    {
        registered_candidates "$topic"
        canonical_candidates "$topic"
    } |
    verify_candidates |
    awk -F '\t' -v topic="$topic" '
        !seen[$1 SUBSEP $3]++ {
            print
            found = 1
        }
        END {
            if (topic != "" && !found) {
                printf "%s: no verified local checkout\n", topic > "/dev/stderr"
                exit 1
            }
        }
    '
}

register_checkout() {
    topic=$1
    role=$2
    requested_path=$3

    if ! lookup_tool "$topic"; then
        printf 'unknown Cat Food tool: %s\n' "$topic" >&2
        return 2
    fi

    case $role in
        workbench|acceptance|test|cache|control|other) ;;
        *)
            printf 'invalid checkout role: %s\n' "$role" >&2
            return 2
            ;;
    esac

    tab=$(printf '\t')
    newline='
'
    case $requested_path in
        *"$tab"*|*"$newline"*)
            printf '%s\n' 'checkout paths may not contain tabs or newlines' >&2
            return 2
            ;;
    esac

    if [ ! -d "$requested_path" ]; then
        printf 'checkout path is not a directory: %s\n' "$requested_path" >&2
        return 1
    fi
    checkout=$(CDPATH='' cd -- "$requested_path" && pwd -P)

    if ! repository_matches "$checkout" "$lookup_repository"; then
        printf '%s: %s is not a checkout of %s\n' "$topic" "$checkout" "$lookup_repository" >&2
        return 1
    fi

    validate_checkout_inventory || return $?
    inventory=$(checkout_inventory)
    case $inventory in
        */*)
            inventory_dir=${inventory%/*}
            [ -n "$inventory_dir" ] || inventory_dir=/
            ;;
        *) inventory_dir=. ;;
    esac

    umask 077
    mkdir -p "$inventory_dir"
    temporary_inventory=$inventory.tmp.$$
    trap 'rm -f "$temporary_inventory"' EXIT HUP INT TERM

    if [ -f "$inventory" ]; then
        awk -F '\t' -v tool="$topic" -v checkout="$checkout" '
            /^[[:space:]]*($|#)/ { print; next }
            !($1 == tool && $3 == checkout) { print }
        ' "$inventory" > "$temporary_inventory"
    else
        printf '%s\n' '# catfood-checkouts-v1: TOOL<TAB>ROLE<TAB>ABSOLUTE_PATH' > "$temporary_inventory"
    fi
    printf '%s\t%s\t%s\n' "$topic" "$role" "$checkout" >> "$temporary_inventory"
    mv "$temporary_inventory" "$inventory"
    trap - EXIT HUP INT TERM

    printf '%s\t%s\t%s\n' "$topic" "$role" "$checkout"
}

show_target=0
case ${1:-} in
    '') ;;
    --target) show_target=1 ;;
    -h|--help) usage; exit 0 ;;
    help)
        show_help_page "${2:-}"
        exit $?
        ;;
    where)
        if [ -n "${3:-}" ]; then
            usage >&2
            exit 2
        fi
        where_inventory "${2:-}"
        exit $?
        ;;
    register)
        if [ "$#" -ne 4 ]; then
            usage >&2
            exit 2
        fi
        register_checkout "$2" "$3" "$4"
        exit $?
        ;;
    *) usage >&2; exit 2 ;;
esac

target=${CATFOOD_TARGET:-auto}
if [ "$target" = auto ]; then
    target=$(detect_target)
fi

case $target in
    hetzner) target=cloud ;;
    phone|tablet|container|cloud|termux) ;;
    *)
        printf 'CATFOOD_TARGET must be phone, tablet, container, cloud, termux, or hetzner; found: %s\n' "$target" >&2
        exit 2
        ;;
esac

if [ "$show_target" -eq 1 ]; then
    printf '%s\n' "$target"
    exit 0
fi

case $target in
    cloud)
        CATFOOD_ROOT=${CATFOOD_ROOT:-/opt}
        CATFOOD_BUILD_TOOLS=${CATFOOD_BUILD_TOOLS:-1}
        CATFOOD_INSTALL_YSH=${CATFOOD_INSTALL_YSH:-1}
        ;;
    container)
        if [ -w /opt ]; then default_root=/opt; else default_root=$HOME/opt; fi
        CATFOOD_ROOT=${CATFOOD_ROOT:-$default_root}
        CATFOOD_BUILD_TOOLS=${CATFOOD_BUILD_TOOLS:-1}
        CATFOOD_INSTALL_YSH=${CATFOOD_INSTALL_YSH:-1}
        CATFOOD_NO_PROFILE=${CATFOOD_NO_PROFILE:-1}
        CATFOOD_DEPTH=${CATFOOD_DEPTH:-1}
        export CATFOOD_NO_PROFILE CATFOOD_DEPTH
        ;;
    phone|tablet|termux)
        CATFOOD_ROOT=${CATFOOD_ROOT:-$HOME/opt}
        CATFOOD_BUILD_TOOLS=${CATFOOD_BUILD_TOOLS:-0}
        CATFOOD_INSTALL_YSH=${CATFOOD_INSTALL_YSH:-0}
        ;;
esac

CATFOOD_TARGET=$target
export CATFOOD_TARGET CATFOOD_ROOT CATFOOD_BUILD_TOOLS CATFOOD_INSTALL_YSH

exec sh "$root/provision.sh"
