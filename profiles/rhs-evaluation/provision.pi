"""Bounded GitHub-hosted Ubuntu profile; consumer compile/link uses ICK."""
import sys
import os
import platform
import subprocess
import hashlib
import zipfile
import json
from pathlib import Path
from builtins import ValueError, globals

ICK ∈ str ← "e3c2a40b4edafc4d9caca55d1f7c094e6aab9589"
ITHON ∈ str ← "d6e83969f82512e920fb17b44326cb54f31d015c"
GREASE_SOURCE ∈ str ← "9a874c4e082d26f21b2cc807b5553e7e19d5f590"
GREASE_ARCHIVE ∈ str ← "71e679fef031225716bbb4d6ea140ab17e9d44e7aa6bd4964e7bccbbed6ce323"

def digest(data ∈ bytes) → str:
    value ∈ str ← hashlib.sha256(data).hexdigest()
    return value

def write(path ∈ str, value ∈ str) → None:
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text(value)

def run(argv ∈ list[str], cwd ∈ str, log ∈ str) → str:
    write(log + "/argv.json", json.dumps(argv))
    result ∈ object ← subprocess.run(argv, cwd=cwd, capture_output=True)
    Path(log + "/stdout.bin").write_bytes(result.stdout)
    Path(log + "/stderr.bin").write_bytes(result.stderr)
    code ∈ int ← result.returncode
    write(log + "/exit.txt", str(code) + "\n")
    if code != 0:
        print("Provision failed:", argv[0], "exit", code, "log", log)
        stderr ∈ str ← result.stderr.decode(errors="replace")
        print(stderr[-6000:])
        raise ValueError("Host provision failed; no stock consumer fallback")
    stdout ∈ str ← result.stdout.decode(errors="replace")
    return stdout

def verify_source(work ∈ str, name ∈ str, revision ∈ str) → None:
    observed ∈ str ← run(["git", "rev-parse", "HEAD"], work + "/" + name, work + "/provision/" + name + "-revision").strip()
    if observed != revision:
        raise ValueError("Owner checkout revision mismatch: " + name)

def provision(work ∈ str) → None:
    actions ∈ str ← os.environ.get("GITHUB_ACTIONS", "")
    system ∈ str ← platform.system()
    machine ∈ str ← platform.machine()
    if actions != "true" or system != "Linux" or machine != "x86_64":
        raise ValueError("This profile requires observed GitHub-hosted Ubuntu x86_64")
    release ∈ str ← Path("/etc/os-release").read_text()
    if not ("ID=ubuntu" in release):
        raise ValueError("This profile requires observed Ubuntu")
    verify_source(work, "ick", ICK)
    verify_source(work, "ithon", ITHON)
    description ∈ str ← platform.platform()
    write(work + "/provision/host.txt", release + "\n" + description + "\n")
    run(["sudo", "apt-get", "update"], work, work + "/provision/apt-update")
    run(["sudo", "apt-get", "install", "-y", "build-essential", "flex", "bison", "texinfo", "libgmp-dev", "libmpfr-dev", "libmpc-dev", "libisl-dev", "libzstd-dev", "binutils-aarch64-linux-gnu", "gcc-aarch64-linux-gnu", "libc6-dev-arm64-cross", "qemu-user", "python3-venv"], work, work + "/provision/apt-install")
    archive ∈ str ← work + "/provision/grease.zip"
    run(["gh", "api", "/repos/dilapidated-shed/grease/actions/artifacts/11419782646/zip"], work, work + "/provision/grease-download")
    Path(archive).write_bytes(Path(work + "/provision/grease-download/stdout.bin").read_bytes())
    archive_hash ∈ str ← digest(Path(archive).read_bytes())
    if archive_hash != GREASE_ARCHIVE:
        raise ValueError("Pinned Grease archive digest mismatch")
    zip ∈ object ← zipfile.ZipFile(archive)
    members ∈ list[str] ← zip.namelist()
    selected ∈ list[str] ← []
    for member in members:
        if member.endswith("/ysh") or member == "ysh":
            selected.append(member)
    if len(selected) != 1:
        raise ValueError("Pinned Grease archive has no unique runtime executable")
    executable ∈ str ← work + "/profile/grease-runtime/ysh"
    Path(executable).parent.mkdir(parents=True, exist_ok=True)
    Path(executable).write_bytes(zip.read(selected[0]))
    Path(executable).chmod(493)
    run(["sudo", "sysctl", "-w", "vm.mmap_rnd_bits=28"], work, work + "/provision/asan-host")
    launcher ∈ str ← work + "/profile/bin/grease"
    write(launcher, "#!" + executable + "\nexport ASAN_OPTIONS=detect_leaks=0\nexec " + executable + ' "$@"\n')
    Path(launcher).chmod(493)
    run([launcher, "-c", "var result = 6 * 7; write -- rhs-$result"], work, work + "/provision/grease-smoke")
    write(work + "/profile/grease.tsv", "source\t" + GREASE_SOURCE + "\ninherited_source\t5651cf97a1b5042f24f14112a7ade9a1518eb0bc\nartifact\t11419782646\narchive_sha256\t" + archive_hash + "\nexecutable_sha256\t" + digest(Path(executable).read_bytes()) + "\n")
    run(["python3", "-m", "venv", work + "/model-runtime"], work, work + "/provision/venv")
    interpreter ∈ str ← work + "/model-runtime/bin/python"
    run([interpreter, "-m", "pip", "install", "--only-binary=:all:", "torch==2.5.1+cpu", "--index-url", "https://download.pytorch.org/whl/cpu"], work, work + "/provision/torch")
    run([interpreter, "-m", "pip", "install", "--only-binary=:all:", "transformers==4.46.3"], work, work + "/provision/transformers")
    freeze ∈ str ← run([interpreter, "-m", "pip", "freeze", "--all"], work, work + "/provision/dependencies")
    write(work + "/profile/dependencies.txt", freeze)
    print("Pinned Grease and foreign model runtime acquired")
    # Existing owner materializer is inherited bootstrap source.
    run(["sh", work + "/ick/ick/materialize.sh", work + "/ick/gcc", work + "/ick-source"], work, work + "/provision/materialize")
    build ∈ str ← work + "/ick-build"
    Path(build).mkdir(parents=True, exist_ok=True)
    run([work + "/ick-source/configure", "--target=aarch64-linux-gnu", "--prefix=" + work + "/ick-stage", "--with-as=/usr/bin/aarch64-linux-gnu-as", "--with-ld=/usr/bin/aarch64-linux-gnu-ld", "--enable-languages=c", "--disable-bootstrap", "--disable-multilib", "--disable-nls", "--disable-shared", "--disable-threads", "--without-headers", "--disable-libatomic", "--disable-libgomp", "--disable-libquadmath", "--disable-libssp", "--disable-libvtv"], build, work + "/provision/configure")
    print("Building pinned ICK C compiler")
    run(["make", "-j2", "all-gcc"], build, work + "/provision/build")
    run(["make", "install-gcc"], build, work + "/provision/install")
    compiler ∈ str ← work + "/ick-stage/bin/aarch64-linux-gnu-gcc"
    cc1 ∈ str ← run([compiler, "-print-prog-name=cc1"], work, work + "/provision/cc1").strip()
    target ∈ str ← run([compiler, "-dumpmachine"], work, work + "/provision/target").strip()
    if target != "aarch64-linux-gnu":
        raise ValueError("ICK target does not match declared qualification")
    # Foreign cross-GCC is queried only for bootstrap CRT/libgcc support paths.
    libgcc ∈ str ← run(["aarch64-linux-gnu-gcc", "-print-libgcc-file-name"], work, work + "/provision/foreign-support-path").strip()
    support ∈ str ← str(Path(libgcc).parent)
    syslib ∈ str ← "/usr/aarch64-linux-gnu/lib"
    argv ∈ list[str] ← [compiler, "-std=c11", "-Wall", "-Wextra", "-Wpedantic", "@OPT@", "-isystem", "/usr/aarch64-linux-gnu/include", "-nostdlib", "-static", "-no-pie", syslib + "/crt1.o", syslib + "/crti.o", support + "/crtbeginT.o", "@SOURCE@", "-L" + syslib, "-L" + support, "-Wl,--start-group", "-lc", "-lm", "-lgcc", "-lgcc_eh", "-Wl,--end-group", support + "/crtend.o", syslib + "/crtn.o", "-o", "@OUTPUT@"]
    joined ∈ str ← "\n".join(argv)
    write(work + "/profile/compile-argv.txt", joined + "\n")
    write(work + "/profile/runtime-argv.txt", "/usr/bin/qemu-aarch64\n")
    write(work + "/profile/profile.tsv", "toolchain\tick\ntarget\tLinux/AArch64/QEMU\nick_revision\t" + ICK + "\nithon_revision\t" + ITHON + "\ncompiler\t" + compiler + "\ncompiler_sha256\t" + digest(Path(compiler).read_bytes()) + "\ncc1\t" + cc1 + "\ncc1_sha256\t" + digest(Path(cc1).read_bytes()) + "\nforeign_support\t" + support + "\n")
    run(["dpkg-query", "-W"], work, work + "/provision/packages")
    run(["qemu-aarch64", "--version"], work, work + "/provision/qemu")
    print("Host profile ready; consumer compiler=ICK; runtime=QEMU; fallback=none")

def main() → None:
    arguments ∈ list[str] ← sys.argv
    args ∈ list[str] ← arguments[1:]
    if args[0] == "check":
        print("Ithon provision frontend passed")
    elif args[0] == "from-workspace-file":
        work ∈ str ← Path(args[1]).read_text().strip()
        provision(work)
    else:
        provision(args[0])

namespace ∈ dict[str, object] ← globals()
module_name ∈ str ← namespace.get("__name__", "")
if module_name == "__main__":
    main()
