#!/usr/bin/env ysh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
workspace=${CATFOOD_ROOT:-/opt}
history_depth=${CATFOOD_DEPTH:-12}
manifest=${CATFOOD_MANIFEST:-$root/tools.tsv}
failures=0

feed_repository() {
    name=$1
    repository=$2
    branch=$3
    submodules=$4
    target=$workspace/$name

    printf '%-22s %s\n' "$name" "$target"

    if [ -e "$target/.git" ]; then
        origin=$(git -C "$target" remote get-url origin 2>/dev/null || true)
        if [ "$origin" != "$repository" ]; then
            printf '  origin is %s, expected %s; leaving it alone\n' "${origin:-<missing>}" "$repository" >&2
            return 1
        fi

        if ! git -C "$target" fetch --prune origin "$branch"; then
            printf '  fetch failed\n' >&2
            return 1
        fi

        if [ -n "$(git -C "$target" status --porcelain)" ]; then
            printf '  local changes present; fetched but did not move it\n'
            return 0
        fi

        if git -C "$target" show-ref --verify --quiet "refs/heads/$branch"; then
            if ! git -C "$target" checkout "$branch"; then
                return 1
            fi
        else
            if ! git -C "$target" checkout -b "$branch" --track "origin/$branch"; then
                return 1
            fi
        fi

        if ! git -C "$target" merge --ff-only "origin/$branch"; then
            printf '  local history diverged; not rewriting it\n' >&2
            return 1
        fi
    elif [ -e "$target" ]; then
        printf '  path exists but is not a git checkout; leaving it alone\n' >&2
        return 1
    else
        if ! git clone --depth "$history_depth" --single-branch --branch "$branch" \
            "$repository" "$target"; then
            return 1
        fi
    fi

    if [ "$submodules" = recursive ]; then
        if ! git -C "$target" submodule sync --recursive || \
           ! git -C "$target" submodule update --init --recursive --depth "$history_depth"; then
            printf '  submodule update failed\n' >&2
            return 1
        fi
    fi
}

command -v git >/dev/null 2>&1 || {
    printf '%s\n' 'cat food needs git' >&2
    exit 127
}
mkdir -p "$workspace"

while read -r name repository branch submodules || [ -n "${name:-}" ]; do
    case ${name:-} in
        ''|'#'*) continue ;;
    esac

    if ! feed_repository "$name" "$repository" "$branch" "$submodules"; then
        failures=1
    fi
done < "$manifest"

if [ "$failures" -ne 0 ]; then
    printf '%s\n' 'cat food finished with failures' >&2
    exit 1
fi

printf 'cat food is current under %s\n' "$workspace"
