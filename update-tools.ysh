#!/usr/bin/env ysh
set -eu

# The first feed may still use POSIX sh before a runnable YSH exists.  Explicit
# arguments also carry configuration into YSH, whose ENV object is intentionally
# separate from shell variables.
script_dir=$(dirname -- "$0")
root=$(CDPATH='' cd -- "$script_dir" && pwd)
workspace=${1:-${CATFOOD_ROOT:-/opt}}
history_depth=${2:-${CATFOOD_DEPTH:-12}}
manifest=${3:-${CATFOOD_MANIFEST:-$root/tools.tsv}}
links_only=${4:-${CATFOOD_LINKS_ONLY:-0}}
failures=0

feed_repository() {
    name=$1
    repository=$2
    branch=$3
    submodules=$4
    target=$workspace/$name

    printf '%-22s %s\n' "$name" "$target"

    if test -e "$target/.git"; then
        origin=$(git -C "$target" remote get-url origin 2>/dev/null || true)
        if test "$origin" != "$repository"; then
            printf '  origin is %s, expected %s; leaving it alone\n' "${origin:-<missing>}" "$repository" >&2
            failures=1
            return 0
        fi

        if ! git -C "$target" fetch --prune origin "$branch"; then
            printf '  fetch failed\n' >&2
            failures=1
            return 0
        fi

        status=$(git -C "$target" status --porcelain)
        if test -n "$status"; then
            printf '  local changes present; fetched but did not move it\n'
            return 0
        fi

        if git -C "$target" show-ref --verify --quiet "refs/heads/$branch"; then
            if ! git -C "$target" checkout "$branch"; then
                failures=1
                return 0
            fi
        else
            if ! git -C "$target" checkout -b "$branch" --track "origin/$branch"; then
                failures=1
                return 0
            fi
        fi

        if ! git -C "$target" merge --ff-only "origin/$branch"; then
            printf '  local history diverged; not rewriting it\n' >&2
            failures=1
            return 0
        fi
    elif test -e "$target"; then
        printf '  path exists but is not a git checkout; leaving it alone\n' >&2
        failures=1
        return 0
    else
        if ! git clone --depth "$history_depth" --single-branch --branch "$branch" \
            "$repository" "$target"; then
            failures=1
            return 0
        fi
    fi

    if test "$submodules" = recursive; then
        if ! git -C "$target" submodule sync --recursive || \
           ! git -C "$target" submodule update --init --recursive --depth "$history_depth"; then
            printf '  submodule update failed\n' >&2
            failures=1
            return 0
        fi
    fi
}

link_first() {
    name=$1
    shift
    link=$workspace/bin/$name

    for candidate do
        if test -x "$candidate"; then
            if test -e "$link" && test ! -L "$link"; then
                printf '  %s exists and is not a symlink; leaving it alone\n' "$link" >&2
                failures=1
                return 0
            fi
            if ! rm -f "$link"; then
                failures=1
                return 0
            fi
            if ! ln -s "$candidate" "$link"; then
                failures=1
                return 0
            fi
            return 0
        fi
    done

    return 0
}

link_shell() {
    name=$1
    shift
    link=$workspace/bin/$name

    # Provisioning may deliberately point the stable shell name at a released
    # native Oils install outside the source checkout. Keep that link as long
    # as it is still runnable instead of regressing to an older source launcher.
    if test -L "$link" && test -x "$link" && "$link" -c 'echo' >/dev/null 2>&1; then
        return 0
    fi

    link_first "$name" "$@"
}

install_az_wrapper() {
    name=$1
    script=$workspace/az/bin/$name
    wrapper=$workspace/bin/$name

    test -f "$script" || return 0

    if test -e "$wrapper" || test -L "$wrapper"; then
        if test -f "$wrapper" && grep -F '# catfood az wrapper' "$wrapper" >/dev/null 2>&1; then
            true
        elif test -L "$wrapper"; then
            if ! rm -f "$wrapper"; then
                failures=1
                return 0
            fi
        else
            printf '  %s exists and is not a Cat Food wrapper; leaving it alone\n' "$wrapper" >&2
            failures=1
            return 0
        fi
    fi

    if ! cat > "$wrapper" <<'EOF'
#!/bin/sh
# catfood az wrapper
set -eu
bin_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
workspace=$(dirname -- "$bin_dir")
name=$(basename -- "$0")
script=$workspace/az/bin/$name

# az's checked-in test suite and shell features target Bash.  Keep the stable
# command on that tested interpreter until the repository adds a YSH gate.
exec bash "$script" "$@"
EOF
    then
        failures=1
        return 0
    fi
    if ! chmod 0755 "$wrapper"; then
        failures=1
    fi
}

install_command_links() {
    if ! mkdir -p "$workspace/bin"; then
        failures=1
        return 0
    fi

    link_first R \
        "$workspace/r/bin/R"
    link_first Rscript \
        "$workspace/r/bin/Rscript"
    link_first edric \
        "$workspace/Idric/edric"
    link_first idris2 \
        "$workspace/Idric/build/exec/idris2" \
        "$workspace/Idric/idris2"
    link_first fieldmouse \
        "$workspace/fieldmouse/build/exec/fieldmouse"
    link_first icu \
        "$workspace/icu/build/exec/icu"
    link_first ib-smoke \
        "$workspace/ib/src/build/exec/ib-smoke"
    link_first ick \
        "$workspace/ick-runtime/bin/ick" \
        "$workspace/ick-runtime/bin/gcc"
    link_first ithon \
        "$workspace/.build/ithon/python" \
        "$workspace/ithon/ithon" \
        "$workspace/ithon/bin/ithon"
    link_shell osh \
        "$workspace/oils/_bin/cxx-sh/osh" \
        "$workspace/oils/bin/osh" \
        "$workspace/oils/osh"
    link_shell ysh \
        "$workspace/oils/_bin/cxx-sh/ysh" \
        "$workspace/oils/bin/ysh" \
        "$workspace/oils/ysh"
    link_first grease \
        "$workspace/.build/grease/bin/grease" \
        "$workspace/grease/_bin/cxx-sh/ysh" \
        "$workspace/grease/bin/ysh" \
        "$workspace/grease/ysh" \
        "$workspace/grease/source/_bin/cxx-sh/ysh" \
        "$workspace/grease/source/bin/ysh"

    install_az_wrapper az
    install_az_wrapper abe
}

command -v git >/dev/null 2>&1 || {
    printf '%s\n' 'cat food needs git' >&2
    exit 127
}
mkdir -p "$workspace"

if test "$links_only" != 1; then
    while read -r name repository branch submodules || test -n "${name:-}"; do
        case ${name:-} in
            ''|\#*) continue ;;
        esac

        feed_repository "$name" "$repository" "$branch" "$submodules"
    done < "$manifest"
fi

install_command_links

if test "$failures" -ne 0; then
    printf '%s\n' 'cat food finished with failures' >&2
    exit 1
fi

if test "$links_only" = 1; then
    printf 'cat food links are current under %s/bin\n' "$workspace"
else
    printf 'cat food is current under %s\n' "$workspace"
    printf 'commands are under %s/bin\n' "$workspace"
fi
