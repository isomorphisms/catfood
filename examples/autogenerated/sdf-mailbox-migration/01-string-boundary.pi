"""Checked read-only host evidence. No mailbox content read or mutation."""
import argparse
import os
from pathlib import Path
import pwd
import shutil
import stat
import sys
from builtins import FileNotFoundError, OSError, RuntimeError

def probe(source ∈ str, destination ∈ str, require_netbsd ∈ bool = False) → list[str]:
    major ∈ int ← sys.version_info.major
    minor ∈ int ← sys.version_info.minor
    if major < 3 or (major == 3 and minor < 9):
        raise RuntimeError("Python 3.9 or newer substrate required")
    system ∈ object ← os.uname()
    system_name ∈ str ← system.sysname
    if require_netbsd and system_name != "NetBSD":
        raise RuntimeError("SDF qualification requires an observed NetBSD host")
    fields ∈ list[str] ← [system.sysname, system.nodename, system.release, system.version, system.machine]
    version ∈ str ← sys.version
    account ∈ str ← pwd.getpwuid(os.getuid()).pw_name
    groups ∈ list[int] ← os.getgroups()
    group_names ∈ list[str] ← []
    for group in groups:
        group_names.append(str(group))
    lines ∈ list[str] ← ["system\t" + "\t".join(fields),
        "python\t" + version.replace("\n", " "), "account\t" + account,
        "uid\t" + str(os.getuid()), "groups\t" + ",".join(group_names)]
    source_path ∈ object ← Path(source)
    destination_path ∈ object ← Path(destination)
    if not source_path.is_absolute() or not destination_path.is_absolute():
        raise RuntimeError("absolute paths required; expand the account home explicitly")
    roles ∈ list[str] ← ["source", "source-directory", "archive", "archive-directory"]
    paths ∈ list[object] ← [source_path, source_path.parent, destination_path, destination_path.parent]
    for index in range(len(roles)):
        role ∈ str ← roles[index]
        path ∈ object ← paths[index]
        lines.append(role + "\t" + str(path))
        try:
            item ∈ object ← os.lstat(path)
            metadata ∈ list[str] ← [str(item.st_dev), str(item.st_ino), str(item.st_uid),
                str(item.st_gid), str(stat.S_IMODE(item.st_mode)), str(item.st_size)]
            lines.append(role + "-metadata\t" + "\t".join(metadata))
            lines.append(role + "-access\tread=" + str(os.access(path, os.R_OK)) + "\twrite=" + str(os.access(path, os.W_OK)))
        except FileNotFoundError:
            lines.append(role + "-metadata\tMISSING")
    directories ∈ list[object] ← [source_path.parent, destination_path.parent]
    for directory in directories:
        try:
            lines.append("free-space\t" + str(directory) + "\t" + str(shutil.disk_usage(directory).free))
        except OSError as error:
            lines.append("free-space\t" + str(directory) + "\tUNAVAILABLE " + str(error))
    for tool in ["lockf", "flock", "mail.local", "dotlock", "postconf"]:
        found ∈ str | None ← shutil.which(tool)
        lines.append("utility\t" + tool + "\t" + (found or "MISSING"))
    lines.append("delivery-lock\tUNKNOWN")
    lines.append("mailbox-mutation\tnone")
    return lines

__name__ ∈ str
if __name__ == "__main__":
    parser ∈ object ← argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", required=True)
    parser.add_argument("--destination", required=True)
    parser.add_argument("--require-netbsd", action="store_true")
    arguments ∈ object ← parser.parse_args()
    source_argument ∈ str ← arguments.source
    destination_argument ∈ str ← arguments.destination
    netbsd_argument ∈ bool ← arguments.require_netbsd
    try:
        for line in probe(source_argument, destination_argument, netbsd_argument):
            print(line)
    except (OSError, RuntimeError) as error:
        print("REFUSED: " + str(error), file=sys.stderr)
        sys.exit(1)
