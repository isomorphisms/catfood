#!/usr/bin/env grease
set -eu
workspace=${CATFOOD_ROOT:-/opt}
runner=${CATFOOD_GREASE:-$workspace/bin/grease}
repository=$workspace/cloud-storage-api
fail() { printf 'Cat Food cloud storage: %s\n' "$*" >&2; exit 2; }
case $workspace in /*) ;; *) fail 'workbench root must be absolute' ;; esac
case $runner in /*) ;; *) fail 'declared Grease runtime must be absolute' ;; esac
name=$(basename -- "$0")
case $name in
 google-drive-api|google-drive-auth|google-drive-files|google-drive-download|google-drive-zip-inventory|google-drive-copy-tree|sdf-mailbox-stream-upload) file=$name.grease ;;
 google-drive-unzip) file=google-drive-unzip.ysh ;;
 *) fail 'invoke a registered cloud-storage command name' ;;
esac
test -x "$runner" || fail 'declared Grease runtime is missing'
test -d "$repository/.git" || fail 'declared cloud-storage workbench checkout is missing'
origin=$(git -C "$repository" remote get-url origin)
test "$origin" = https://github.com/dilapidated-shed/cloud-storage-api.git || fail 'cloud-storage origin differs from inventory'
test -f "$repository/commands/$file" || fail 'selected command is absent from this source generation'
exec "$runner" "$repository/commands/$file" "$@"
